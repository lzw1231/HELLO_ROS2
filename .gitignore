# ============================================
# CLion / IDE 相关
# ============================================
.idea/
cmake-build-*/
*.iml
.DS_Store

# ============================================
# ROS2 / Colcon 构建产物
# ============================================
# 工作空间构建目录
build/
install/
log/

# 符号链接（如果是通过 colcon 创建的）
install_isolated/
build_isolated/

# ============================================
# CMake 生成文件
# ============================================
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
CMakeUserPresets.json

# ============================================
# 编译数据库（可以忽略，也可以保留）
# ============================================
# 如果你不想把 compile_commands.json 提交到仓库：
compile_commands.json
build/compile_commands.json

# 如果想保留（推荐项目不提交，每人本地生成）：
# !compile_commands.json

